<Window x:Class="ToDo.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nm="clr-namespace:ToDo.ViewModels"
        xmlns:local="clr-namespace:ToDo.Views"
        mc:Ignorable="d"
        Title="ToDo" Height="320" Width="350" WindowStartupLocation="CenterScreen"
        MaxHeight="400" MaxWidth="450" MinHeight="300" MinWidth="310">
    <Window.DataContext>
        <nm:LoginViewModel />
    </Window.DataContext>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Content="ToDo 📝" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" 
                   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"/>

            <Label Content="Email" Margin="5" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"/>
            <TextBox Text="{Binding Email}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="30" VerticalAlignment="Bottom" />

            <Label Content="Password" Margin="5" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"/>
            <TextBox Text="{Binding Password}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="30" VerticalAlignment="Bottom"/>

            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
       Text="{Binding StatusMessage}"
       Foreground="{Binding StatusColor}"
       HorizontalAlignment="Center"
       VerticalAlignment="Center" />
            
            <Button Content="LOG IN" Command="{Binding LoginCommand}" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" />

            <Button Content="Forgot Password?" Command="{Binding GoToCodeCommand}" FontSize="10" Grid.Row="5" Grid.Column="1"/>
            <Button Content="Register" Command="{Binding GoToRegisterCommand}" FontSize="10" Grid.Row="5" Grid.Column="3"/>
        </Grid>
    </Grid>
</Window>

