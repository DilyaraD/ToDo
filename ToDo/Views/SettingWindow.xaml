<Window x:Class="ToDo.Views.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDo.Views"
        mc:Ignorable="d"
        Title="SettingWindow"   Height="320" Width="700" WindowStartupLocation="CenterScreen"
        MaxHeight="400" MaxWidth="750" MinHeight="300" MinWidth="650">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Content="Profile Settings" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" 
                   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"/>

            <Label Content="Login" Margin="5" Grid.Row="1" Grid.Column="1"/>
            <TextBlock Text="tt" FontSize="14" Grid.Row="1" Grid.Column="1" Height="30" VerticalAlignment="Bottom" />

            <Label Content="New Password" Margin="5" Grid.Row="1" Grid.Column="3"/>
            <TextBox  x:Name="NewPasswordBox" Grid.Row="1" Grid.Column="3" Height="30" VerticalAlignment="Bottom" />

            <Label Content="Current Password"  Margin="5" Grid.Row="2" Grid.Column="1"/>
            <TextBox  Grid.Row="2" Grid.Column="1" x:Name="CurrentPasswordBox" Height="30" VerticalAlignment="Bottom"/>

            <Label Content="Confirm New Password" Margin="5" Grid.Row="2" Grid.Column="3"/>
            <TextBox  x:Name="ConfirmPasswordBox" Grid.Row="2" Grid.Column="3" Height="30" VerticalAlignment="Bottom"/>

            <Button Content="SAVE" Grid.Row="3" Grid.Column="1"  />
            <Button Content="LOGOUT" Grid.Row="3" Grid.Column="3" />
            <Button Content="CANCEL" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" />

        </Grid>
    </Grid>
</Window>
