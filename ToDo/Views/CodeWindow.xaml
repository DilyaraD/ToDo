<Window x:Class="ToDo.Views.CodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nm="clr-namespace:ToDo.ViewModels"
        xmlns:local="clr-namespace:ToDo.Views"
        mc:Ignorable="d" Height="450" Width="350" WindowStartupLocation="CenterScreen"
        MaxHeight="460" MaxWidth="450" MinHeight="440" MinWidth="300"
        Title="{Binding WindowTitle}">
    <Window.DataContext>
        <nm:CodeViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Label Content="{Binding WindowTitle}"
               HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"
               Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,10,0,15"/>

        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmailStep}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Label Content="Email" Margin="5"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="30"/>

            <Button Content="Send code" Command="{Binding GoToSendCodeCommand}"
                    Height="35" Margin="0,20,0,0" IsDefault="True"/>

            <Button Content="CANCEL" Command="{Binding GoToBackCommand}"  Height="35" Margin="0,20,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsResetStep}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Label Content="Code" Margin="5"/>
            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Height="30"/>

            <Label Content="New Password" Margin="5"/>
            <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Height="30"/>

            <Label Content="Confirm Password" Margin="5"/>
            <TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Height="30"/>

            <Button Content="Reset password" Command="{Binding GoToResetCommand}"
                    Height="35" Margin="0,15,0,0" IsDefault="True"/>
            
            <Button Content="CANCEL" Command="{Binding GoToBackCommand}" Height="35" Margin="0,20,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10"
                   Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}"/>
    </Grid>
</Window>