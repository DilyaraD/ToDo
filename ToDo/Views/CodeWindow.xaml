<Window x:Class="ToDo.Views.CodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDo.Views"
        xmlns:nm="clr-namespace:ToDo.ViewModels"
        mc:Ignorable="d"  Height="370" Width="350" WindowStartupLocation="CenterScreen"
        MaxHeight="450" MaxWidth="450" MinHeight="350" MinWidth="300">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Content="i" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" 
                   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"/>

            <TextBlock Grid.Row="1"  HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,20" TextAlignment="Center"/>

            <Label Content="Email" Margin="5" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="30" VerticalAlignment="Bottom" />

            <Label Content="New Password" Margin="5" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" />
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="30" VerticalAlignment="Bottom"/>

            <Label Content="Code" Margin="5" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"/>
            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Height="30" VerticalAlignment="Bottom"/>

            <Label Content="Confirm Password" Margin="5" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"/>
            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Height="30" VerticalAlignment="Bottom" />

            <Button Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" />
            <Button Height="35" Margin="0,10,0,0" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" />
            <Button  Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" />

            <TextBlock Grid.Row="7" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
