<Window x:Class="ToDo.Views.AddEditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDo.Views"
        mc:Ignorable="d"
        Title="AddEditTaskWindow" 
        Height="430" Width="350" WindowStartupLocation="CenterScreen"
        MaxHeight="480" MaxWidth="450" MinHeight="380" MinWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="l" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" Grid.Row="0"/>

        <Label Content="Title" Margin="0,0,0,5" Grid.Row="1"/>
        <TextBox Grid.Row="1" Height="35" VerticalAlignment="Bottom" Margin="0,25,0,0" Padding="10,0"/>

        <Label Content="Category" Margin="0,0,0,5" Grid.Row="2"/>
        <ComboBox Grid.Row="2" Height="35" VerticalAlignment="Bottom" Margin="0,25,0,0"/>

        <StackPanel Grid.Row="3">
            <Label Content="Priority" Margin="0,0,10,0"/>
            <ComboBox Height="35"  VerticalAlignment="Bottom"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <Label Content="Due Date" Margin="0,0,0,5" />
            <DatePicker Height="35" Grid.Row="4" VerticalAlignment="Bottom"/>
        </StackPanel>

        <TextBlock Grid.Row="5"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        
        <Button Content="SAVE" Grid.Row="6" Width="120" Margin="0,10,0,10"/>
        <Button Content="CANCEL" Grid.Row="7" Width="120"/>
    </Grid>
</Window>

