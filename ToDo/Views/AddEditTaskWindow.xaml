<Window x:Class="ToDo.Views.AddEditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nm="clr-namespace:ToDo.ViewModels"
        xmlns:local="clr-namespace:ToDo.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="450" Width="350" WindowStartupLocation="CenterScreen"
        MaxHeight="500" MaxWidth="450" MinHeight="400" MinWidth="300">
    <Window.DataContext>
        <nm:AddEditTaskViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="{Binding WindowTitle}" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" Grid.Row="0"/>

        <Label Content="Title" Margin="0,0,0,5" Grid.Row="1"/>
        <TextBox Grid.Row="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="35" VerticalAlignment="Bottom" Margin="0,25,0,0" Padding="10,0"/>

        <Label Content="Category" Margin="0,0,0,5" Grid.Row="2"/>
        <ComboBox Grid.Row="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}" Height="35" VerticalAlignment="Bottom" Margin="0,25,0,0"/>

        <StackPanel Grid.Row="3">
            <Label Content="Priority" Margin="0,0,10,0"/>
            <ComboBox Height="35" ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <Label Content="Due Date" Margin="0,0,0,5" />
            <DatePicker Height="35" Grid.Row="4" SelectedDate="{Binding DueDate, UpdateSourceTrigger=PropertyChanged}" 
                        VerticalAlignment="Bottom"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" FontSize="14"/>

        <Button Content="SAVE" Command="{Binding GoToSaveCommand}" Grid.Row="6" Width="120" Margin="0,10,0,10"/>
        <Button Content="CANCEL" Command="{Binding GoToBackCommand}" Grid.Row="7" Width="120"/>
    </Grid>
</Window>

