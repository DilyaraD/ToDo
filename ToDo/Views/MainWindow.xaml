<Window x:Class="ToDo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nm="clr-namespace:ToDo.ViewModels"
        xmlns:local="clr-namespace:ToDo.Views"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        Title="My tasks" MinHeight="450" MinWidth="800" >
    <Window.DataContext>
        <nm:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="📋 My tasks" FontSize="24" FontWeight="Bold"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Profile" Margin="0,0,10,0" Command="{Binding GoToProfileCommand}"/>
                <Button Content="Log out" Command="{Binding LogoutCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8" Margin="0,0,10,0" FontSize="14"/>

                <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" 
                          Margin="0,0,10,0" FontSize="14"/>

                <ComboBox Grid.Column="2" ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}" 
                          Margin="0,0,10,0" FontSize="14"/>

                <Button Grid.Column="3" Margin="0,0,10,0" Content="Reset" Command="{Binding ResetFilterCommand}" FontSize="13"/>
            </Grid>
        </Grid>

        <DataGrid Grid.Row="2" AutoGenerateColumns="False" ItemsSource="{Binding Tasks}" CanUserAddRows="False"
                  CanUserDeleteRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="✅" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Left" IsChecked="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}"
                                      Command="{Binding DataContext.GoToUpdateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                      CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />

                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />

                <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="100" />

                <DataGridTextColumn Header="DueDate" Binding="{Binding DueDate, StringFormat=dd-MM-yyyy}" Width="120" />

                <DataGridTemplateColumn Header="Action" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="✍︎" Background="MediumPurple" BorderThickness="0" FontSize="16" 
                                        Command="{Binding DataContext.GoToEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="🗑️" Background="MediumPurple" BorderThickness="0" FontSize="16" Margin="5,0" 
                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TasksSummary}" FontSize="12" VerticalAlignment="Center" Margin="10"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Add task" Margin="5" Command="{Binding GoToAddTaskCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
